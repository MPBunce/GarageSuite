<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">My Appointments</h1>
    <p class="text-gray-500 text-sm mt-1">Track and manage your bookings</p>
  </div>
  <%= link_to "📅 Book New Appointment", booking_path,
        class: "bg-blue-600 hover:bg-blue-700 text-white font-medium
                px-4 py-2.5 rounded-lg transition text-sm" %>
</div>

<% if @appointments.any? %>
  <div class="space-y-4">
    <% @appointments.each do |apt| %>
      <div class="bg-white rounded-xl border border-gray-200 p-5 hover:shadow-sm transition">
        <div class="flex items-start justify-between">
          <div class="flex-1">
            <div class="flex items-center space-x-3 mb-2">
              <h3 class="font-semibold text-gray-900 text-lg">
                <%= apt.service.name %>
              </h3>
              <span class="px-2 py-0.5 rounded-full text-xs font-medium
                <%= case apt.status
                    when 'pending'   then 'bg-yellow-100 text-yellow-800'
                    when 'confirmed' then 'bg-green-100 text-green-800'
                    when 'completed' then 'bg-gray-100 text-gray-600'
                    when 'cancelled' then 'bg-red-100 text-red-700'
                    end %>">
                <%= apt.status.capitalize %>
              </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-sm text-gray-500">
              <div>
                <span class="text-gray-400">🚗 Vehicle</span>
                <p class="font-medium text-gray-700 mt-0.5">
                  <%= apt.vehicle_display %>
                </p>
              </div>
              <div>
                <span class="text-gray-400">📅 Date & Time</span>
                <p class="font-medium text-gray-700 mt-0.5">
                  <%= apt.scheduled_at
                          .in_time_zone("Eastern Time (US & Canada)")
                          .strftime("%b %d, %Y at %l:%M %p EST") %>
                </p>
              </div>
              <div>
                <span class="text-gray-400">💰 Price</span>
                <p class="font-medium text-gray-700 mt-0.5">
                  <%= apt.service.formatted_price %>
                </p>
              </div>
            </div>

            <% if apt.confirmed? && apt.assigned_admin.present? %>
              <p class="text-xs text-green-600 mt-3">
                ✅ Confirmed by <%= apt.assigned_admin.full_name %>
              </p>
            <% end %>

            <% if apt.customer_notes.present? %>
              <p class="text-xs text-gray-400 mt-2">
                📝 "<%= apt.customer_notes %>"
              </p>
            <% end %>
          </div>

          <%# Actions %>
          <div class="ml-4 flex flex-col space-y-2">
            <%= link_to "View", customer_appointment_path(apt),
                  class: "text-center text-sm text-blue-600 hover:text-blue-700
                          font-medium border border-blue-200 hover:border-blue-400
                          px-3 py-1.5 rounded-lg transition" %>
            <% if apt.pending? %>
              <%= button_to "Cancel",
                    customer_appointment_path(apt),
                    method: :delete,
                    data: { turbo_confirm: "Cancel this appointment?" },
                    class: "text-sm text-red-600 hover:text-red-700 font-medium
                            border border-red-200 hover:border-red-400
                            px-3 py-1.5 rounded-lg transition" %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="bg-white rounded-xl border border-dashed border-gray-300 p-16 text-center">
    <p class="text-4xl mb-4">📅</p>
    <h3 class="text-lg font-semibold text-gray-900 mb-2">No appointments yet</h3>
    <p class="text-gray-400 text-sm mb-6">
      Book your first appointment and we'll take care of the rest
    </p>
    <%= link_to "Book an Appointment", booking_path,
          class: "bg-blue-600 hover:bg-blue-700 text-white font-medium
                  px-6 py-2.5 rounded-lg transition" %>
  </div>
<% end %>