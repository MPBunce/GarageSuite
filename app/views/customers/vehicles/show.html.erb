<div class="max-w-lg mx-auto">
  <div class="mb-6">
    <%= link_to "← Back to Vehicles", customer_vehicles_path,
          class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>

  <div class="bg-white rounded-2xl border border-gray-200 p-8">
    <div class="flex items-center space-x-4 mb-6">
      <span class="text-5xl">🚗</span>
      <div>
        <h1 class="text-2xl font-bold text-gray-900">
          <%= @vehicle.display_name %>
        </h1>
      </div>
    </div>

    <div class="space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div>
          <p class="text-xs text-gray-400 uppercase tracking-wide mb-1">Make</p>
          <p class="font-medium text-gray-900"><%= @vehicle.make %></p>
        </div>
        <div>
          <p class="text-xs text-gray-400 uppercase tracking-wide mb-1">Model</p>
          <p class="font-medium text-gray-900"><%= @vehicle.model %></p>
        </div>
        <div>
          <p class="text-xs text-gray-400 uppercase tracking-wide mb-1">Year</p>
          <p class="font-medium text-gray-900"><%= @vehicle.year %></p>
        </div>
      </div>

      <% if @vehicle.vin.present? %>
        <div class="border-t border-gray-100 pt-4">
          <p class="text-xs text-gray-400 uppercase tracking-wide mb-1">VIN</p>
          <p class="font-medium text-gray-900 font-mono text-sm">
            <%= @vehicle.vin %>
          </p>
        </div>
      <% end %>

      <div class="border-t border-gray-100 pt-4">
        <p class="text-xs text-gray-400 uppercase tracking-wide mb-3">
          Appointment History
        </p>
        <% if @vehicle.appointments.any? %>
          <div class="space-y-2">
            <% @vehicle.appointments.includes(:service)
                       .order(scheduled_at: :desc).limit(5).each do |apt| %>
              <div class="flex items-center justify-between text-sm">
                <span class="text-gray-700"><%= apt.service.name %></span>
                <span class="text-gray-400">
                  <%= apt.scheduled_at.present? ?
                          apt.scheduled_at.in_time_zone("Eastern Time (US & Canada)").strftime("%b %d, %Y") :
                          "To be scheduled" %>
                </span>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-gray-400">No appointments yet with this vehicle</p>
        <% end %>
      </div>
    </div>

    <div class="mt-8 pt-6 border-t border-gray-100 flex space-x-3">
      <%= link_to "📅 Book Appointment", booking_path,
            class: "flex-1 text-center bg-orange-600 hover:bg-orange-700 text-white
                    font-medium py-2.5 rounded-lg transition text-sm" %>
      <%= button_to "Remove Vehicle",
            customer_vehicle_path(@vehicle),
            method: :delete,
            data: { turbo_confirm: "Remove this vehicle?" },
            class: "flex-1 border border-red-300 hover:bg-red-50 text-red-600
                    font-medium py-2.5 rounded-lg transition text-sm" %>
    </div>
  </div>
</div>