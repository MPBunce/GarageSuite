<div class="max-w-lg mx-auto">
  <div class="flex items-center space-x-3 mb-6">
    <%= link_to "← Back to Vehicles", customer_vehicles_path,
          class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>

  <div class="bg-white rounded-2xl border border-gray-200 p-8">
    <h1 class="text-2xl font-bold text-gray-900 mb-2">Add a Vehicle</h1>
    <p class="text-gray-500 text-sm mb-6">
      Save your vehicle for faster booking next time
    </p>

    <%= form_with url: customer_vehicles_path, method: :post do |f| %>

      <% if @vehicle.errors.any? %>
        <div class="mb-6 bg-red-50 border border-red-200 rounded-lg p-4">
          <ul class="list-disc list-inside text-red-600 text-sm space-y-1">
            <% @vehicle.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Make</label>
          <%= f.text_field :make,
                placeholder: "e.g. Toyota",
                class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm
                        focus:outline-none focus:ring-2 focus:ring-orange-500" %>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Model</label>
          <%= f.text_field :model,
                placeholder: "e.g. Camry",
                class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm
                        focus:outline-none focus:ring-2 focus:ring-orange-500" %>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Year</label>
          <%= f.number_field :year,
                placeholder: "e.g. 2020",
                min: 1990,
                max: Date.current.year + 1,
                class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm
                        focus:outline-none focus:ring-2 focus:ring-orange-500" %>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">
            License Plate
          </label>
          <%= f.text_field :license_plate,
                placeholder: "e.g. ABC123",
                class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm
                        focus:outline-none focus:ring-2 focus:ring-orange-500" %>
        </div>
      </div>

      <div class="mb-6">
        <label class="block text-sm font-medium text-gray-700 mb-1">
          VIN <span class="text-gray-400 font-normal">(optional)</span>
        </label>
        <%= f.text_field :vin,
              placeholder: "Vehicle Identification Number",
              class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm
                      focus:outline-none focus:ring-2 focus:ring-orange-500" %>
      </div>

      <%= f.submit "Save Vehicle",
            class: "w-full bg-gray-800 hover:bg-gray-900 text-white font-semibold
                    py-2.5 px-4 rounded-lg transition cursor-pointer text-sm" %>
    <% end %>
  </div>
</div>