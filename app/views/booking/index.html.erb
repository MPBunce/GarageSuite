<%# Progress Bar %>
<div class="max-w-2xl mx-auto mb-8">
  <div class="flex items-start">
    <% steps = @step_labels %>
    <% current = @step %>
    <% step_keys = @step_keys %>
    <% current_index = step_keys.index(current) || 0 %>

    <% steps.each_with_index do |label, i| %>
      <div class="flex items-start <%= i < steps.length - 1 ? 'flex-1' : '' %>">
        <div class="flex flex-col items-center min-w-[4.5rem]">
          <div class="w-9 h-9 rounded-full flex items-center justify-center text-sm font-semibold
            <%= current_index >= i ? 'bg-orange-600 text-white' : 'bg-gray-200 text-gray-500' %>">
            <%= i + 1 %>
          </div>
          <span class="text-xs mt-1 font-medium text-center
            <%= current_index >= i ? 'text-orange-600' : 'text-gray-400' %>">
            <%= label %>
          </span>
        </div>
        <% if i < steps.length - 1 %>
          <div class="h-0.5 flex-1 mx-2 mt-4
            <%= current_index > i ? 'bg-orange-600' : 'bg-gray-200' %>">
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<%# Step Content %>
<div class="max-w-2xl mx-auto">
  <% step = @step %>

  <%# ── STEP 1: Service Selection ── %>
  <% if step == "service" %>
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-2">Choose a Service</h2>
      <p class="text-gray-500 text-sm mb-6">Select the service you'd like to book</p>

      <%= form_tag booking_update_path, method: :post do %>
        <input type="hidden" name="step" value="service">

        <div class="space-y-3">
          <% @services.each do |service| %>
            <label class="flex flex-col gap-3 p-4 border-2 border-gray-200 rounded-xl
                          cursor-pointer transition hover:border-orange-400 sm:flex-row
                          sm:items-center sm:justify-between sm:gap-4
                          has-[:checked]:border-orange-600 has-[:checked]:bg-orange-50">
              <div class="flex min-w-0 items-start gap-4 sm:flex-1 sm:items-center">
                <%= radio_button_tag :service_id, service.id,
                      session.dig(:booking, "service_id").to_s == service.id.to_s,
                      class: "w-4 h-4 text-orange-600" %>
                <div class="min-w-0 flex-1">
                  <p class="font-semibold text-gray-900 line-clamp-2 break-words"><%= service.name %></p>
                  <p class="text-sm text-gray-500 line-clamp-2 break-words"><%= service.description %></p>

                  <div class="mt-3 flex items-center justify-between gap-3 sm:hidden">
                    <% if service.request_pricing? %>
                      <p class="inline-flex items-center rounded-full bg-orange-50 px-3 py-1 text-xs font-semibold text-orange-700 border border-orange-200 max-w-full break-words leading-tight text-center">
                        <%= service.formatted_price %>
                      </p>
                    <% else %>
                      <p class="min-w-0 font-bold text-orange-600"><%= service.formatted_price %></p>
                    <% end %>
                    <p class="shrink-0 text-xs text-gray-400 whitespace-nowrap">⏱ <%= service.formatted_duration %></p>
                  </div>
                </div>
              </div>
              <div class="hidden w-44 shrink-0 self-center text-right sm:flex sm:flex-col sm:items-end">
                <% if service.request_pricing? %>
                  <p class="inline-flex items-center rounded-full bg-orange-50 px-3 py-1 text-xs font-semibold text-orange-700 border border-orange-200 max-w-full break-words leading-tight text-center">
                    <%= service.formatted_price %>
                  </p>
                <% else %>
                  <p class="font-bold text-orange-600 whitespace-nowrap"><%= service.formatted_price %></p>
                <% end %>
                <p class="mt-2 text-xs text-gray-400 whitespace-nowrap">⏱ <%= service.formatted_duration %></p>
              </div>
            </label>
          <% end %>
        </div>

        <div class="mt-8">
          <%= submit_tag "Continue →",
                class: "w-full bg-orange-600 hover:bg-orange-700 text-white font-semibold
                        py-3 px-4 rounded-lg transition cursor-pointer" %>
        </div>
      <% end %>
    </div>

  <%# ── STEP 2: Vehicle ── %>
  <% elsif step == "vehicle" %>
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-2">Your Vehicle</h2>
      <p class="text-gray-500 text-sm mb-6">Tell us about the vehicle being serviced</p>

      <%= form_tag booking_update_path, method: :post do %>
        <input type="hidden" name="step" value="vehicle">

        <% if user_signed_in? && current_user.vehicles.active.any? %>
          <p class="text-sm font-medium text-gray-700 mb-3">Select a saved vehicle:</p>
          <div class="space-y-3 mb-6">
            <% current_user.vehicles.active.each do |vehicle| %>
              <label class="flex items-center space-x-4 p-4 border-2 border-gray-200
                            rounded-xl cursor-pointer hover:border-orange-400 transition
                            has-[:checked]:border-orange-600 has-[:checked]:bg-orange-50">
                <%= radio_button_tag :vehicle_id, vehicle.id, false,
                      class: "w-4 h-4 text-orange-600" %>
                <span class="font-medium text-gray-900"><%= vehicle.display_name %></span>
                <span class="text-sm text-gray-400"><%= vehicle.license_plate %></span>
              </label>
            <% end %>
          </div>
          <p class="text-sm text-gray-400 text-center mb-4">— or enter a different vehicle —</p>
        <% end %>

        <div class="grid grid-cols-2 gap-4 mb-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Make</label>
            <input type="text" name="guest_vehicle_make" placeholder="e.g. Toyota"
              class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm
                     focus:outline-none focus:ring-2 focus:ring-orange-500">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Model</label>
            <input type="text" name="guest_vehicle_model" placeholder="e.g. Camry"
              class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm
                     focus:outline-none focus:ring-2 focus:ring-orange-500">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4 mb-8">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Year</label>
            <input type="number" name="guest_vehicle_year" placeholder="e.g. 2020"
              min="1990" max="<%= Date.current.year + 1 %>"
              class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm
                     focus:outline-none focus:ring-2 focus:ring-orange-500">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">
              License Plate <span class="text-red-500">*</span>
            </label>
            <input type="text" name="guest_vehicle_license" placeholder="e.g. ABC123"
              required
              class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm
                    focus:outline-none focus:ring-2 focus:ring-orange-500">
          </div>
        </div>

        <%= submit_tag "Continue →",
              class: "w-full bg-orange-600 hover:bg-orange-700 text-white font-semibold
                      py-3 px-4 rounded-lg transition cursor-pointer" %>
      <% end %>
    </div>

  <%# ── STEP 3: Request Notes ── %>
  <% elsif step == "datetime" %>
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-2">Additional Notes</h2>
      <p class="text-gray-500 text-sm mb-6">
        Share any details that will help our team.
        <span class="text-orange-600 font-medium">Date and time will be assigned by an admin.</span>
      </p>

      <%= form_tag booking_update_path, method: :post do %>
        <input type="hidden" name="step" value="datetime">

        <div class="mb-8">
          <label class="block text-sm font-medium text-gray-700 mb-1">
            Notes <span class="text-gray-400 font-normal">(optional)</span>
          </label>
          <textarea name="customer_notes" rows="3"
            placeholder="Any specific concerns or requests..."
            class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm
                   focus:outline-none focus:ring-2 focus:ring-orange-500 resize-none">
          </textarea>
        </div>

        <%= submit_tag "Continue →",
              class: "w-full bg-orange-600 hover:bg-orange-700 disabled:bg-gray-300
                      disabled:cursor-not-allowed text-white font-semibold
                      py-3 px-4 rounded-lg transition cursor-pointer" %>
      <% end %>
    </div>

  <%# ── STEP 4: Your Details ── %>
  <% elsif step == "details" %>
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-2">Your Details</h2>

      <% if user_signed_in? %>
        <p class="text-gray-500 text-sm mb-6">
          Booking as
          <span class="font-medium text-gray-800"><%= current_user.full_name %></span>
        </p>

        <%= form_tag booking_update_path, method: :post do %>
          <input type="hidden" name="step" value="details">
          <%= submit_tag "Review Booking →",
                class: "w-full bg-orange-600 hover:bg-orange-700 text-white font-semibold
                        py-3 px-4 rounded-lg transition cursor-pointer" %>
        <% end %>

      <% else %>
        <p class="text-gray-500 text-sm mb-6">
          No account needed — just enter your contact details
        </p>

        <%= form_tag booking_update_path, method: :post do %>
          <input type="hidden" name="step" value="details">

          <div class="mb-5">
            <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
            <input type="text" name="guest_name" placeholder="John Smith" required
              class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm
                     focus:outline-none focus:ring-2 focus:ring-orange-500">
          </div>

          <div class="mb-5">
            <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
            <input type="email" name="guest_email" placeholder="john@example.com" required
              class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm
                     focus:outline-none focus:ring-2 focus:ring-orange-500">
            <p class="mt-1 text-xs text-gray-400">Your confirmation will be sent here</p>
          </div>

          <div class="mb-8">
            <label class="block text-sm font-medium text-gray-700 mb-1">Phone Number</label>
            <input type="tel" name="guest_phone" placeholder="+1 (555) 000-0000"
              class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm
                     focus:outline-none focus:ring-2 focus:ring-orange-500">
          </div>

          <% if @account_creation_enabled %>
            <%# Optional account creation %>
            <div class="border-t border-gray-100 pt-6 mb-6">

              <%# Hidden field ensures value "0" is always submitted if checkbox unticked %>
              <input type="hidden" name="create_account" value="0">

              <label class="flex items-start space-x-3 cursor-pointer">
                <input type="checkbox"
                  id="create_account_toggle"
                  name="create_account"
                  value="1"
                  class="mt-0.5 w-4 h-4 text-orange-600 border-gray-300 rounded">
                <div>
                  <p class="text-sm font-medium text-gray-800">
                    Create a free account
                    <span class="text-gray-400 font-normal">(optional)</span>
                  </p>
                  <p class="text-xs text-gray-400 mt-0.5">
                    Track this and future appointments online
                  </p>
                </div>
              </label>

              <div id="account_fields" class="hidden mt-4 space-y-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">
                    Password
                  </label>
                  <input type="password"
                    name="account_password"
                    placeholder="Min. 6 characters"
                    class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm
                          focus:outline-none focus:ring-2 focus:ring-orange-500">
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">
                    Confirm Password
                  </label>
                  <input type="password"
                    name="account_password_confirmation"
                    class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm
                          focus:outline-none focus:ring-2 focus:ring-orange-500">
                </div>
              </div>

            </div>
          <% end %>

          <%= submit_tag "Review Booking →",
                class: "w-full bg-orange-600 hover:bg-orange-700 text-white font-semibold
                        py-3 px-4 rounded-lg transition cursor-pointer" %>
        <% end %>

        <% if @account_creation_enabled %>
          <script>
            document.getElementById('create_account_toggle')
              .addEventListener('change', function() {
                document.getElementById('account_fields')
                  .classList.toggle('hidden', !this.checked);
              });
          </script>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>