<div class="max-w-md mx-auto py-12">
  <div class="text-center mb-8">
    <h2 class="text-2xl font-bold text-gray-900">Look Up Your Appointment</h2>
    <p class="text-gray-500 text-sm mt-2">
      Enter the email you used when booking
    </p>
  </div>

  <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8">
    <%= form_tag appointment_result_path, method: :get do %>
      <div class="mb-6">
        <label class="block text-sm font-medium text-gray-700 mb-1">
          Booking Reference Token
        </label>
        <input type="text" name="token" placeholder="Paste your booking token"
          class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm
                 focus:outline-none focus:ring-2 focus:ring-blue-500">
        <p class="mt-1 text-xs text-gray-400">
          Found in your confirmation email or the URL from your booking page
        </p>
      </div>

      <%= submit_tag "Find My Appointment",
            class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold
                    py-2.5 px-4 rounded-lg transition cursor-pointer" %>
    <% end %>
  </div>

  <p class="text-center text-sm text-gray-400 mt-6">
    Have an account?
    <%= link_to "Sign in here", new_user_session_path,
          class: "text-blue-600 hover:text-blue-700 font-medium" %>
  </p>
</div>