<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4">
  <div class="max-w-md w-full">

    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold text-gray-900">🔧 Auto Enterprise</h1>
      <h2 class="mt-3 text-xl text-gray-600">Reset your password</h2>
      <p class="mt-2 text-sm text-gray-500">
        We'll send you a link to reset your password.
      </p>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8">
      <%= form_for(resource, as: resource_name,
            url: password_path(resource_name),
            html: { method: :post }) do |f| %>

        <div class="mb-6">
          <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.email_field :email,
                autofocus: true,
                autocomplete: "email",
                class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg
                        focus:outline-none focus:ring-2 focus:ring-orange-500
                        focus:border-transparent text-gray-900 text-sm" %>
        </div>

        <%= f.submit "Send Reset Instructions",
              class: "w-full bg-orange-600 hover:bg-orange-700 text-white font-semibold
                      py-2.5 px-4 rounded-lg transition cursor-pointer text-sm" %>

        <div class="mt-4 text-center">
          <%= link_to "Back to Sign In",
                new_user_session_path,
                class: "text-sm text-orange-600 hover:text-orange-700 font-medium" %>
        </div>

      <% end %>
    </div>

  </div>
</div>