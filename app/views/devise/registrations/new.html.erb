<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4">
  <div class="max-w-md w-full">

    <%# Header %>
    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold text-gray-900">🔧 Auto Enterprise</h1>
      <h2 class="mt-3 text-xl text-gray-600">Create your account</h2>
      <p class="mt-2 text-sm text-gray-500">
        Already have an account?
        <%= link_to "Sign in here", new_user_session_path,
              class: "text-blue-600 hover:text-blue-700 font-medium" %>
      </p>
    </div>

    <%# Card %>
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8">
      <%= form_for(resource, as: resource_name,
            url: registration_path(resource_name)) do |f| %>

        <%# Error messages %>
        <% if resource.errors.any? %>
          <div class="mb-6 bg-red-50 border border-red-200 rounded-lg p-4">
            <p class="text-red-700 text-sm font-medium mb-1">
              Please fix the following errors:
            </p>
            <ul class="list-disc list-inside text-red-600 text-sm space-y-1">
              <% resource.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%# First name + Last name side by side %>
        <div class="grid grid-cols-2 gap-4 mb-5">
          <div>
            <%= f.label :first_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :first_name,
                  autofocus: true,
                  class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg
                          focus:outline-none focus:ring-2 focus:ring-blue-500
                          focus:border-transparent text-gray-900 text-sm" %>
          </div>
          <div>
            <%= f.label :last_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :last_name,
                  class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg
                          focus:outline-none focus:ring-2 focus:ring-blue-500
                          focus:border-transparent text-gray-900 text-sm" %>
          </div>
        </div>

        <%# Email %>
        <div class="mb-5">
          <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.email_field :email,
                autocomplete: "email",
                class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg
                        focus:outline-none focus:ring-2 focus:ring-blue-500
                        focus:border-transparent text-gray-900 text-sm" %>
        </div>

        <%# Phone number %>
        <div class="mb-5">
          <%= f.label :phone_number, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.telephone_field :phone_number,
                placeholder: "+1 (555) 000-0000",
                class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg
                        focus:outline-none focus:ring-2 focus:ring-blue-500
                        focus:border-transparent text-gray-900 text-sm" %>
        </div>

        <%# Password %>
        <div class="mb-5">
          <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.password_field :password,
                autocomplete: "new-password",
                class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg
                        focus:outline-none focus:ring-2 focus:ring-blue-500
                        focus:border-transparent text-gray-900 text-sm" %>
          <p class="mt-1 text-xs text-gray-400">Minimum 6 characters</p>
        </div>

        <%# Password confirmation %>
        <div class="mb-6">
          <%= f.label :password_confirmation,
                "Confirm Password",
                class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.password_field :password_confirmation,
                autocomplete: "new-password",
                class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg
                        focus:outline-none focus:ring-2 focus:ring-blue-500
                        focus:border-transparent text-gray-900 text-sm" %>
        </div>

        <%# Submit %>
        <%= f.submit "Create Account",
              class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold
                      py-2.5 px-4 rounded-lg transition cursor-pointer text-sm" %>

      <% end %>
    </div>

  </div>
</div>