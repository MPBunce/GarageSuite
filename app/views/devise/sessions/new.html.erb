<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4">
  <div class="max-w-md w-full">

    <%# Header %>
    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold text-gray-900">🔧 Auto Enterprise</h1>
      <h2 class="mt-3 text-xl text-gray-600">Sign in to your account</h2>
      <p class="mt-2 text-sm text-gray-500">
        Don't have an account?
        <%= link_to "Sign up here", new_user_registration_path,
              class: "text-blue-600 hover:text-blue-700 font-medium" %>
      </p>
    </div>

    <%# Card %>
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8">
      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

        <%# Email %>
        <div class="mb-5">
          <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.email_field :email,
                autofocus: true,
                autocomplete: "email",
                class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg
                        focus:outline-none focus:ring-2 focus:ring-blue-500
                        focus:border-transparent text-gray-900 text-sm" %>
        </div>

        <%# Password %>
        <div class="mb-5">
          <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.password_field :password,
                autocomplete: "current-password",
                class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg
                        focus:outline-none focus:ring-2 focus:ring-blue-500
                        focus:border-transparent text-gray-900 text-sm" %>
        </div>

        <%# Remember me + Forgot password %>
        <div class="flex items-center justify-between mb-6">
          <% if devise_mapping.rememberable? %>
            <label class="flex items-center space-x-2 cursor-pointer">
              <%= f.check_box :remember_me,
                    class: "w-4 h-4 text-blue-600 border-gray-300 rounded" %>
              <span class="text-sm text-gray-600">Remember me</span>
            </label>
          <% end %>
          <%= link_to "Forgot your password?",
                new_user_password_path,
                class: "text-sm text-blue-600 hover:text-blue-700 font-medium" %>
        </div>

        <%# Submit %>
        <%= f.submit "Sign In",
              class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold
                      py-2.5 px-4 rounded-lg transition cursor-pointer text-sm" %>

      <% end %>
    </div>

  </div>
</div>