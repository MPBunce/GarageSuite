<%# Hero Section %>
<div class="text-center py-20">
  <h1 class="mb-4 flex items-center justify-center gap-3 text-5xl font-bold text-gray-900">
    <%= image_tag "Logo.jpg", alt: "#{site_name} logo", width: 48, height: 48, class: "h-12 w-12 rounded-lg object-cover" %>
    <span><%= site_name %></span>
  </h1>
  <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto">
    <%= AppSetting.value(:homepage_description) %>
  </p>

  <% if user_signed_in? %>
    <% if current_user.admin? %>
      <%= link_to "Go to Admin Dashboard",
            admin_dashboard_path,
            class: "bg-orange-600 hover:bg-orange-700 text-white font-semibold px-8 py-3 rounded-lg text-lg transition" %>
    <% else %>
      <%= link_to "Book an Appointment",
            new_customer_appointment_path,
            class: "bg-orange-600 hover:bg-orange-700 text-white font-semibold px-8 py-3 rounded-lg text-lg transition" %>
    <% end %>
  <% else %>
    <div class="flex justify-center space-x-4">
      <%= link_to "Book an Appointment",
            booking_path,
            class: "bg-orange-600 hover:bg-orange-700 text-white font-semibold px-8 py-3 rounded-lg text-lg transition" %>
      <%= link_to "Sign In",
            new_user_session_path,
            class: "border border-gray-300 hover:border-gray-400 text-gray-700 font-semibold px-8 py-3 rounded-lg text-lg transition" %>
    </div>
  <% end %>
</div>

<%# Services Preview %>
<div class="mt-16">
  <h2 class="text-3xl font-bold text-gray-900 text-center mb-10">Our Services</h2>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <% @services.each do |service| %>
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md transition">
        <h3 class="text-lg font-semibold text-gray-900 mb-2 line-clamp-2 break-words"><%= service.name %></h3>
        <p class="text-gray-500 text-sm mb-4 line-clamp-2 break-words"><%= service.description %></p>
        <div class="flex items-start justify-between gap-3">
          <% if service.request_pricing? %>
            <span class="inline-flex items-center rounded-full bg-orange-50 px-3 py-1 text-xs font-semibold text-orange-700 border border-orange-200 max-w-full break-words leading-tight text-center">
              <%= service.formatted_price %>
            </span>
          <% else %>
            <span class="text-orange-600 font-bold text-lg whitespace-nowrap"><%= service.formatted_price %></span>
          <% end %>
          <span class="text-gray-400 text-sm shrink-0 whitespace-nowrap">⏱ <%= service.formatted_duration %></span>
        </div>
      </div>
    <% end %>
  </div>
</div>

<%# Contact Info %>
<div class="mt-16 rounded-2xl border border-gray-200 bg-white p-8 shadow-sm">
  <h2 class="text-3xl font-bold text-gray-900 text-center mb-3">Contact Us</h2>
  <p class="text-gray-600 text-center mb-8">Questions before you book? Reach out and we can help.</p>

  <div class="mx-auto flex max-w-4xl flex-wrap justify-center gap-3">
    <a href="tel:<%= AppSetting.value(:contact_phone) %>"
       class="flex min-w-0 w-full items-center justify-center rounded-lg border border-gray-200 px-5 py-3 text-gray-700 transition hover:border-orange-300 hover:text-orange-700 sm:w-[calc(50%-0.375rem)] lg:w-[calc(33.333%-0.5rem)]">
      📞 <span class="ml-2 break-words font-semibold"><%= AppSetting.value(:contact_phone) %></span>
    </a>

    <a href="mailto:<%= AppSetting.value(:contact_email) %>"
       class="flex min-w-0 w-full items-center justify-center rounded-lg border border-gray-200 px-5 py-3 text-gray-700 transition hover:border-orange-300 hover:text-orange-700 sm:w-[calc(50%-0.375rem)] lg:w-[calc(33.333%-0.5rem)]">
      ✉️ <span class="ml-2 break-all font-semibold"><%= AppSetting.value(:contact_email) %></span>
    </a>

    <% {
      instagram: [ "Instagram", :instagram_username, "M7.5 2h9A5.5 5.5 0 0 1 22 7.5v9a5.5 5.5 0 0 1-5.5 5.5h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2Zm0 2A3.5 3.5 0 0 0 4 7.5v9A3.5 3.5 0 0 0 7.5 20h9a3.5 3.5 0 0 0 3.5-3.5v-9A3.5 3.5 0 0 0 16.5 4h-9ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm5.25-3.5a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5Z" ],
      x: [ "X", :x_username, "M4 3h4.4l4.1 5.5L17.2 3H20l-6.2 7.1L20.5 21h-4.4l-4.7-6.2L6 21H3.2l6.8-7.8L4 3Zm2.2 2 10.9 14h1.2L7.4 5H6.2Z" ],
      tiktok: [ "TikTok", :tiktok_username, "M14.7 3c.3 2.3 1.6 3.7 3.8 4v3.1c-1.3 0-2.5-.4-3.7-1.2v6.3a5.8 5.8 0 1 1-5-5.7v3.1a2.8 2.8 0 1 0 2 2.7V3h2.9Z" ]
    }.each do |platform, (label, setting_key, icon_path)| %>
      <% username = AppSetting.value(setting_key) %>
      <% if username.present? %>
        <a href="<%= social_profile_url(platform, username) %>"
           target="_blank"
           rel="noopener noreferrer"
           aria-label="<%= label %>: <%= social_profile_handle(username) %>"
           class="flex min-w-0 w-full items-center justify-center rounded-lg border border-gray-200 px-5 py-3 text-gray-700 transition hover:border-orange-300 hover:text-orange-700 sm:w-[calc(50%-0.375rem)] lg:w-[calc(33.333%-0.5rem)]">
          <svg aria-hidden="true" class="h-5 w-5 shrink-0 fill-current" viewBox="0 0 24 24"><path d="<%= icon_path %>" /></svg>
          <span class="ml-2 break-all font-semibold"><%= social_profile_handle(username) %></span>
        </a>
      <% end %>
    <% end %>
  </div>
</div>