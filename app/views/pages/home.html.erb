<%# Hero Section %>
<div class="text-center py-20">
  <h1 class="text-5xl font-bold text-gray-900 mb-4">
    🔧 Auto Enterprise
  </h1>
  <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto">
    Professional automotive services. Book your appointment online
    and let our team take care of the rest.
  </p>

  <% if user_signed_in? %>
    <% if current_user.admin? %>
      <%= link_to "Go to Admin Dashboard",
            admin_dashboard_path,
            class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold px-8 py-3 rounded-lg text-lg transition" %>
    <% else %>
      <%= link_to "Book an Appointment",
            new_customer_appointment_path,
            class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold px-8 py-3 rounded-lg text-lg transition" %>
    <% end %>
  <% else %>
    <div class="flex justify-center space-x-4">
      <%= link_to "Book an Appointment",
            booking_path,
            class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold px-8 py-3 rounded-lg text-lg transition" %>
      <%= link_to "Sign In",
            new_user_session_path,
            class: "border border-gray-300 hover:border-gray-400 text-gray-700 font-semibold px-8 py-3 rounded-lg text-lg transition" %>
    </div>
  <% end %>
</div>

<%# Services Preview %>
<div class="mt-16">
  <h2 class="text-3xl font-bold text-gray-900 text-center mb-10">Our Services</h2>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <% @services.each do |service| %>
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md transition">
        <h3 class="text-lg font-semibold text-gray-900 mb-2"><%= service.name %></h3>
        <p class="text-gray-500 text-sm mb-4"><%= service.description %></p>
        <div class="flex items-center justify-between">
          <span class="text-blue-600 font-bold text-lg"><%= service.formatted_price %></span>
          <span class="text-gray-400 text-sm">⏱ <%= service.formatted_duration %></span>
        </div>
      </div>
    <% end %>
  </div>
</div>