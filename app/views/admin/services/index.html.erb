<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Services</h1>
    <p class="text-gray-500 text-sm mt-1">Manage your service offerings</p>
  </div>
  <%= link_to "➕ Add Service", new_admin_service_path,
        class: "bg-orange-600 hover:bg-orange-700 text-white font-medium
                px-4 py-2.5 rounded-lg transition text-sm" %>
</div>

<% if @services.any? %>
  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
    <% @services.each do |service| %>
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md transition">
        <div class="flex items-start justify-between gap-3 mb-3">
          <h3 class="text-lg font-semibold text-gray-900 min-w-0 line-clamp-2 break-words"><%= service.name %></h3>
          <span class="shrink-0 px-2 py-1 rounded-full text-xs font-medium <%= service.active? ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-500' %>">
            <%= service.active? ? "Active" : "Inactive" %>
          </span>
        </div>

        <p class="text-gray-500 text-sm mb-4 line-clamp-2 break-words"><%= service.description %></p>

        <div class="flex items-start justify-between gap-3 mb-5">
          <% if service.request_pricing? %>
            <span class="inline-flex items-center rounded-full bg-orange-50 px-3 py-1 text-xs font-semibold text-orange-700 border border-orange-200 max-w-full break-words leading-tight text-center">
              <%= service.formatted_price %>
            </span>
          <% else %>
            <span class="text-orange-600 font-bold text-lg whitespace-nowrap"><%= service.formatted_price %></span>
          <% end %>
          <span class="text-gray-400 text-sm shrink-0 whitespace-nowrap">⏱ <%= service.formatted_duration %></span>
        </div>

        <div class="flex items-center justify-end gap-4 pt-3 border-t border-gray-100">
          <%= link_to "Edit",
                edit_admin_service_path(service),
                class: "text-orange-600 hover:text-orange-700 font-medium text-sm" %>
          <%= button_to "Deactivate",
                admin_service_path(service),
                method: :delete,
                data: { turbo_confirm: "Deactivate this service?" },
                class: "text-red-500 hover:text-red-700 font-medium text-sm" %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="bg-white rounded-xl border border-dashed border-gray-300
              p-16 text-center">
    <p class="text-4xl mb-4">🔧</p>
    <h3 class="text-lg font-semibold text-gray-900 mb-2">No services yet</h3>
    <%= link_to "Add your first service", new_admin_service_path,
          class: "bg-orange-600 hover:bg-orange-700 text-white font-medium
                  px-6 py-2.5 rounded-lg transition" %>
  </div>
<% end %>