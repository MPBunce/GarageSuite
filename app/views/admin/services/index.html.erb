<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Services</h1>
    <p class="text-gray-500 text-sm mt-1">Manage your service offerings</p>
  </div>
  <%= link_to "➕ Add Service", new_admin_service_path,
        class: "bg-blue-600 hover:bg-blue-700 text-white font-medium
                px-4 py-2.5 rounded-lg transition text-sm" %>
</div>

<% if @services.any? %>
  <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th class="text-left px-5 py-3 text-xs font-medium text-gray-500
                     uppercase tracking-wide">Service</th>
          <th class="text-left px-5 py-3 text-xs font-medium text-gray-500
                     uppercase tracking-wide">Duration</th>
          <th class="text-left px-5 py-3 text-xs font-medium text-gray-500
                     uppercase tracking-wide">Price</th>
          <th class="text-left px-5 py-3 text-xs font-medium text-gray-500
                     uppercase tracking-wide">Status</th>
          <th class="px-5 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @services.each do |service| %>
          <tr class="hover:bg-gray-50 transition">
            <td class="px-5 py-4">
              <p class="font-medium text-gray-900"><%= service.name %></p>
              <p class="text-xs text-gray-400 mt-0.5">
                <%= truncate(service.description, length: 60) %>
              </p>
            </td>
            <td class="px-5 py-4 text-gray-700">
              <%= service.formatted_duration %>
            </td>
            <td class="px-5 py-4 font-medium text-blue-600">
              <%= service.formatted_price %>
            </td>
            <td class="px-5 py-4">
              <span class="px-2 py-1 rounded-full text-xs font-medium
                <%= service.active? ?
                      'bg-green-100 text-green-800' :
                      'bg-gray-100 text-gray-500' %>">
                <%= service.active? ? "Active" : "Inactive" %>
              </span>
            </td>
            <td class="px-5 py-4 text-right">
              <div class="flex items-center justify-end space-x-3">
                <%= link_to "Edit",
                      edit_admin_service_path(service),
                      class: "text-blue-600 hover:text-blue-700 font-medium" %>
                <%= button_to "Deactivate",
                      admin_service_path(service),
                      method: :delete,
                      data: { turbo_confirm: "Deactivate this service?" },
                      class: "text-red-500 hover:text-red-700 font-medium" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="bg-white rounded-xl border border-dashed border-gray-300
              p-16 text-center">
    <p class="text-4xl mb-4">🔧</p>
    <h3 class="text-lg font-semibold text-gray-900 mb-2">No services yet</h3>
    <%= link_to "Add your first service", new_admin_service_path,
          class: "bg-blue-600 hover:bg-blue-700 text-white font-medium
                  px-6 py-2.5 rounded-lg transition" %>
  </div>
<% end %>