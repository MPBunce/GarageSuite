<% if service.errors.any? %>
  <div class="mb-6 bg-red-50 border border-red-200 rounded-lg p-4">
    <ul class="list-disc list-inside text-red-600 text-sm space-y-1">
      <% service.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="mb-5">
  <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
  <%= f.text_field :name,
        placeholder: "e.g. Oil Change",
        class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm
                focus:outline-none focus:ring-2 focus:ring-blue-500" %>
</div>

<div class="mb-5">
  <%= f.label :description,
        class: "block text-sm font-medium text-gray-700 mb-1" %>
  <%= f.text_area :description,
        rows: 3,
        placeholder: "Describe the service...",
        class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm
                focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none" %>
</div>

<div class="grid grid-cols-2 gap-4 mb-5">
  <div>
    <%= f.label :duration_minutes,
          "Duration (minutes)",
          class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.number_field :duration_minutes,
          placeholder: "e.g. 30",
          min: 15,
          max: 240,
          step: 15,
          class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm
                  focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    <p class="mt-1 text-xs text-gray-400">15 minute increments, max 4 hours</p>
  </div>
  <div>
    <%= f.label :price,
          "Price ($)",
          class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.number_field :price,
          placeholder: "e.g. 49.99",
          min: 0,
          step: 0.01,
          class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm
                  focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>
</div>

<div class="mb-6">
  <label class="flex items-center space-x-3 cursor-pointer">
    <%= f.check_box :active,
          class: "w-4 h-4 text-blue-600 border-gray-300 rounded" %>
    <span class="text-sm font-medium text-gray-700">Active (visible to customers)</span>
  </label>
</div>