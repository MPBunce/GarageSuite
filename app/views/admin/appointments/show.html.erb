<div class="max-w-2xl mx-auto">
  <div class="mb-6">
    <%= link_to "← Back to Appointments", admin_appointments_path,
          class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>

  <div class="bg-white rounded-2xl border border-gray-200 p-8 mb-4">

    <%# Header %>
    <div class="flex items-start justify-between mb-6">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">
          <%= @appointment.service.name %>
        </h1>
        <p class="text-gray-400 text-sm mt-1">
          Requested <%= @appointment.created_at.strftime("%B %d, %Y") %>
        </p>
      </div>
      <span class="px-3 py-1 rounded-full text-sm font-medium
        <%= case @appointment.status
            when 'pending'   then 'bg-yellow-100 text-yellow-800'
            when 'confirmed' then 'bg-green-100 text-green-800'
            when 'completed' then 'bg-gray-100 text-gray-600'
            when 'cancelled' then 'bg-red-100 text-red-700'
            end %>">
        <%= @appointment.status.capitalize %>
      </span>
    </div>

    <%# Details grid %>
    <div class="space-y-5">

      <%# Customer %>
      <div class="pb-5 border-b border-gray-100">
        <p class="text-xs text-gray-400 uppercase tracking-wide mb-2">
          Customer
        </p>
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-full bg-orange-100 flex items-center
                      justify-center text-orange-600 font-semibold">
            <%= @appointment.contact_name.first.upcase %>
          </div>
          <div>
            <p class="font-semibold text-gray-900">
              <%= @appointment.contact_name %>
              <% if @appointment.guest? %>
                <span class="ml-2 text-xs text-orange-500 font-normal">
                  Guest booking
                </span>
              <% end %>
            </p>
            <p class="text-sm text-gray-500"><%= @appointment.contact_email %></p>
            <% if @appointment.contact_phone.present? %>
              <p class="text-sm text-gray-500">
                📞 <%= @appointment.contact_phone %>
              </p>
            <% end %>
          </div>
        </div>
      </div>

      <%# Service + Vehicle %>
      <div class="grid grid-cols-2 gap-5 pb-5 border-b border-gray-100">
        <div>
          <p class="text-xs text-gray-400 uppercase tracking-wide mb-1">
            Service
          </p>
          <p class="font-semibold text-gray-900">
            <%= @appointment.service.name %>
          </p>
          <p class="text-sm text-gray-500">
            <%= @appointment.service.formatted_duration %>
          </p>
          <p class="text-sm text-orange-600 font-medium">
            <%= @appointment.service.formatted_price %>
          </p>
        </div>
        <div>
          <p class="text-xs text-gray-400 uppercase tracking-wide mb-1">
            Vehicle
          </p>
          <p class="font-semibold text-gray-900">
            <%= @appointment.vehicle_display %>
          </p>
        </div>
      </div>

      <%# Appointment schedule %>
      <div class="pb-5 border-b border-gray-100">
        <p class="text-xs text-gray-400 uppercase tracking-wide mb-1">
          Appointment Schedule
        </p>
        <% if @appointment.scheduled_at.present? %>
          <p class="font-semibold text-gray-900">
            <%= @appointment.scheduled_at
                  .in_time_zone("Eastern Time (US & Canada)")
                  .strftime("%A, %B %d, %Y at %l:%M %p EST") %>
          </p>
        <% else %>
          <p class="font-semibold text-gray-900">To be scheduled by admin</p>
        <% end %>
      </div>

      <%# Customer notes %>
      <% if @appointment.customer_notes.present? %>
        <div class="pb-5 border-b border-gray-100">
          <p class="text-xs text-gray-400 uppercase tracking-wide mb-1">
            Customer Notes
          </p>
          <p class="text-gray-700 text-sm bg-gray-50 rounded-lg p-3">
            "<%= @appointment.customer_notes %>"
          </p>
        </div>
      <% end %>

      <%# Admin who confirmed %>
      <% if @appointment.assigned_admin.present? %>
        <div class="pb-5 border-b border-gray-100">
          <p class="text-xs text-gray-400 uppercase tracking-wide mb-1">
            Confirmed By
          </p>
          <p class="font-medium text-green-700">
            ✅ <%= @appointment.assigned_admin.full_name %>
          </p>
        </div>
      <% end %>

      <%# Admin notes form %>
      <div>
        <p class="text-xs text-gray-400 uppercase tracking-wide mb-2">
          Admin Notes
        </p>
        <%= form_with url: admin_appointment_path(@appointment),
              method: :patch do |f| %>
            <%= hidden_field_tag :action_type, "update" %>
          <%= f.text_area :admin_notes,
                value: @appointment.admin_notes,
                rows: 3,
                placeholder: "Add internal notes about this appointment...",
                name: "appointment[admin_notes]",
                class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg
                        text-sm focus:outline-none focus:ring-2
                        focus:ring-orange-500 resize-none" %>
          <%= f.submit "Save Notes",
                class: "mt-2 bg-gray-700 hover:bg-gray-800 text-white text-sm
                        font-medium px-4 py-2 rounded-lg transition cursor-pointer" %>
        <% end %>
      </div>

    </div>
  </div>

  <%# Action buttons %>
  <% if @appointment.pending? %>
    <div class="bg-white rounded-2xl border border-gray-200 p-6">
      <h3 class="font-semibold text-gray-900 mb-4">Actions</h3>
      <% if @appointment.errors.any? %>
        <div class="mb-4 bg-red-50 border border-red-200 rounded-lg p-3">
          <ul class="list-disc list-inside text-sm text-red-700">
            <% @appointment.errors.full_messages.each do |error| %>
              <li><%= error %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with url: admin_appointment_path(@appointment),
            method: :patch,
            class: "space-y-3" do |f| %>
        <%= hidden_field_tag :action_type, "confirm" %>
        <% est_zone = ActiveSupport::TimeZone["Eastern Time (US & Canada)"] %>
        <% est_time = (@appointment.scheduled_at || Time.current.change(hour: 9, min: 0))
                     .in_time_zone("Eastern Time (US & Canada)") %>
        <% time_options = (6..21).flat_map do |hour|
             [0, 30].map do |minute|
               t = est_zone.local(2000, 1, 1, hour, minute)
               [t.strftime("%-l:%M %p"), t.strftime("%H:%M")]
             end
           end %>
        <% ten_pm = est_zone.local(2000, 1, 1, 22, 0) %>
        <% time_options << [ten_pm.strftime("%-l:%M %p"), ten_pm.strftime("%H:%M")] %>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">
              Assign Date (EST)
            </label>
            <%= f.date_field :scheduled_date,
                  value: est_time.strftime("%Y-%m-%d"),
                  name: "appointment[scheduled_date]",
                  required: true,
                  class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm
                          focus:outline-none focus:ring-2 focus:ring-orange-500" %>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">
              Assign Time (EST)
            </label>
            <%= f.select :scheduled_time,
                  options_for_select(time_options, est_time.strftime("%H:%M")),
                  { include_blank: "Select time..." },
                  { name: "appointment[scheduled_time]",
                    required: true,
                    class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm bg-white
                            focus:outline-none focus:ring-2 focus:ring-orange-500" } %>
          </div>
        </div>
        <%= f.submit "✅ Confirm Appointment",
              data: { turbo_confirm: "Confirm this appointment?" },
              class: "w-full bg-green-600 hover:bg-green-700 text-white
                      font-semibold py-2.5 rounded-lg transition text-sm cursor-pointer" %>
      <% end %>

      <div class="mt-3">
        <%= button_to "❌ Cancel",
              admin_appointment_path(@appointment),
              method: :patch,
              params: { action_type: "cancel" },
              data: { turbo_confirm: "Cancel this appointment?" },
              class: "w-full border border-red-300 hover:bg-red-50 text-red-600
                      font-semibold py-2.5 rounded-lg transition text-sm" %>
      </div>
    </div>
  <% elsif @appointment.confirmed? %>
    <div class="bg-white rounded-2xl border border-gray-200 p-6">
      <h3 class="font-semibold text-gray-900 mb-4">Actions</h3>
      <div class="flex space-x-3">
        <%= button_to "🏁 Mark as Completed",
              admin_appointment_path(@appointment),
              method: :patch,
              params: { action_type: "complete" },
              data: { turbo_confirm: "Mark this appointment as complete?" },
              class: "flex-1 bg-orange-600 hover:bg-orange-700 text-white
                      font-semibold py-2.5 rounded-lg transition text-sm" %>
        <%= button_to "❌ Cancel",
              admin_appointment_path(@appointment),
              method: :patch,
              params: { action_type: "cancel" },
              data: { turbo_confirm: "Cancel this appointment?" },
              class: "flex-1 border border-red-300 hover:bg-red-50 text-red-600
                      font-semibold py-2.5 rounded-lg transition text-sm" %>
      </div>
    </div>
  <% end %>
</div>