<%= form_with url: admin_settings_path, method: :patch, class: "space-y-0" do %>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Settings</h1>
    </div>
    <div class="shrink-0">
      <%= submit_tag "Save settings",
            class: "rounded-lg bg-orange-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-orange-700 cursor-pointer" %>
    </div>
  </div>

  <% @setting_groups.each do |group_name, definitions| %>
    <section class="mt-10 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
      <div class="mb-5">
        <h2 class="text-lg font-semibold text-gray-900"><%= group_name %></h2>
        <p class="mt-1 text-sm text-gray-500">
          <%= case group_name
              when "Branding"
                "Brand identity settings shown across the app."
              else
                "Operational controls for booking and dashboard behavior."
              end %>
        </p>
      </div>

      <div>
        <% definitions.each_with_index do |definition, index| %>
          <% key = definition[:key] %>
          <% value = @setting_values.fetch(key) %>
          <% is_boolean = definition[:type] == :boolean %>
          <% previous_type = index.zero? ? nil : definitions[index - 1][:type] %>
          <% spacing_classes = previous_type.present? && previous_type != definition[:type] ? "mt-6" : "mt-4" %>

          <div class="<%= spacing_classes %> flex flex-col gap-4 rounded-xl border border-gray-200 px-4 py-4 transition hover:border-orange-300 md:flex-row md:items-start md:justify-between md:gap-6 <%= 'mt-0' if index.zero? %>">
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-3">
                <p class="font-medium text-gray-900"><%= definition[:label] %></p>
                <% if is_boolean %>
                  <span class="rounded-full px-2.5 py-1 text-xs font-semibold <%= value ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500' %>">
                    <%= value ? "On" : "Off" %>
                  </span>
                <% else %>
                  <span class="rounded-full bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-700">
                    <%= definition[:type].to_s.humanize %>
                  </span>
                <% end %>
              </div>
              <p class="mt-1 text-sm text-gray-500"><%= definition[:description] %></p>
              <p class="mt-2 text-xs uppercase tracking-wide text-gray-400">Key: <%= key %></p>
            </div>

            <div class="w-full md:w-auto md:shrink-0">
              <% if definition[:type] == :boolean %>
                <input type="hidden" name="app_settings[<%= key %>]" value="0">
                <input type="checkbox"
                       name="app_settings[<%= key %>]"
                       value="1"
                       <%= "checked" if value %>
                       class="mt-1 h-5 w-5 rounded border-gray-300 text-orange-600 focus:ring-orange-500">
              <% elsif definition[:type] == :integer %>
                <input type="number"
                       name="app_settings[<%= key %>]"
                       value="<%= value %>"
                       min="0"
                       class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500 md:w-28">
              <% else %>
                <input type="text"
                       name="app_settings[<%= key %>]"
                       value="<%= value %>"
                       class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500 md:w-72">
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
<% end %>