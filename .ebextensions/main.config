option_settings:
  aws:elasticbeanstalk:command:
    Timeout: 2000
  aws:elasticbeanstalk:application:environment:
    RAILS_ENV: production
    RACK_ENV: production
    BUNDLE_PATH: "vendor/bundle"
    BUNDLE_WITHOUT: "test:development"
    RAILS_SKIP_MIGRATIONS: true
    RAILS_SKIP_ASSET_COMPILATION: true
    LOGGING: debug
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: "/up"

packages:
  yum:
    git: []
    curl: []
    openssl-devel: []
    libpq-devel: []

commands:
  01_setup_dirs:
    command: |
      sudo mkdir -p /home/webapp /var/app/current/log/ /var/run/puma /var/log/puma
      sudo chown -R webapp:webapp /home/webapp /var/app/current/ /var/run/puma /var/log/puma
      sudo chmod 0755 /home/webapp

files:
  "/home/ec2-user/rails:console":
    mode: "000755"
    owner: root
    group: root
    content: |
      sudo su - -c 'cd /var/app/current; bundle exec rails console'
  "/home/ec2-user/db:console":
    mode: "000755"
    owner: root
    group: root
    content: |
      sudo su - -c 'cd /var/app/current; bundle exec rails db'
  "/opt/elasticbeanstalk/support/conf/pumaconf.rb":
    mode: "000644"
    content: |
      directory '/var/app/current'
      threads 3, 3
      workers 1
      bind 'unix:///var/run/puma/my_app.sock'
      pidfile '/var/run/puma/puma.pid'
      stdout_redirect '/var/log/puma/puma.log', '/var/log/puma/puma.log', true
      daemonize false

container_commands:
  01_bundle_install:
    command: "bundle install --local --jobs 4 --retry 3"
  02_db_migrate:
    command: "bundle exec rails db:migrate"
    leader_only: true